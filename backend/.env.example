# AgentShield Configuration
PORT=8000
API_HOST=127.0.0.1
DATABASE_URL=sqlite:///./agentshield.db
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=

# PayPal Sandbox Developer Platform Credentials (Never use live endpoints or credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
