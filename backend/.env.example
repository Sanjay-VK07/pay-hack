# Security & API Mutation Guard (Leave empty for loopback-only demo evaluation)
AGENTSHIELD_API_KEY=
REQUIRE_MUTATION_AUTH=false
ALLOW_LOOPBACK_MUTATIONS=true
SECRET_KEY=

# Demo Mode Enabled by Default for Hackathon Judges
DEMO_MODE=true
